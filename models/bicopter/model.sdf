<?xml version="1.0"?>
<sdf version="1.9">
  <model name="bicopter">
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <pose>0.0047 0 0.08 0 0 0</pose>
        <mass>0.40</mass>
        <inertia>
          <ixx>0.000813333</ixx>
          <ixy>0</ixy>
          <iyy>0.001186667</iyy>
          <iyz>0</iyz>
          <izz>0.001333333</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://bicopter/meshes/base.stl</uri>
          </mesh>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://bicopter/meshes/base.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

<!-- sensors -->
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- Airspeed sensor -->
      <include merge="true">
          <uri>model://airspeed</uri>
          <pose>0 0 0 0 0 0</pose>
      </include>
      <joint name='airspeed_joint' type='fixed'>
          <parent>base_link</parent>
          <child>airspeed_link</child>
          <pose relative_to="base_link">-0 0 0 0 0 0</pose>
      </joint>
    <!-- /Airspeed sensor -->

<!--Multicopter configuration-->
  <!-- left servo (ccw) -->
      <link name="servo_1"> <!--"ccw_servo_link" -->
        <pose relative_to="servo_1_joint">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.050</mass>

          <inertia>
            <ixx>8.33333E-06</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>5.41667E-06</iyy>
            <iyz>0</iyz>
            <izz>1.04167E-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://bicopter/meshes/ccw_servo.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://bicopter/meshes/ccw_servo.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5</ambient>
            <diffuse>0.5 0.5 0.5</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <joint name="servo_1_joint" type="revolute">
        <pose relative_to="base_link">0.010312 0.15468 0.15176 0.018488 0 3.14159</pose>
        <parent>base_link</parent>
        <child>servo_1</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit>
            <lower>-0.785398163</lower>
            <upper>0.785398163</upper>
          </limit>
          <dynamics>
            <damping>0.01</damping>
          </dynamics>
        </axis>
      </joint>

    <!-- left motor (ccw) -->
      <link name="ccw_mot_link">
        <pose relative_to="ccw_mot_joint">0 0 0 0 0 0</pose>
        <inertial>
          <pose>7e-06 -1.2e-05 0.017767 0 0 0</pose>
          <mass>0.050</mass>
          <inertia>
            <ixx>1.19292E-05</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1.19292E-05</iyy>
            <iyz>0</iyz>
            <izz>0.000018225</izz>
            </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://bicopter/meshes/ccw_mot.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://bicopter/meshes/ccw_mot.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <joint name="ccw_mot_joint" type="revolute">
        <pose relative_to="servo_1">0 -0.004 0.0425 0 0 0</pose>
        <parent>servo_1</parent>
        <child>ccw_mot_link</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
          <dynamics>
            <damping>0.004</damping>
          </dynamics>
        </axis>
      </joint>

    <!-- right servo (cw) -->
      <link name="servo_0"> <!--"cw_servo_link" -->
        <pose relative_to="servo_0_joint">0 0 0 0 0 0</pose>
        <inertial>

          <pose>0 0 0 0 0 0</pose>

          <mass>0.050</mass>

          <inertia>
            <ixx>8.33333E-06</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>5.41667E-06</iyy>
            <iyz>0</iyz>
            <izz>1.04167E-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://bicopter/meshes/cw_servo.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://bicopter/meshes/cw_servo.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5</ambient>
            <diffuse>0.5 0.5 0.5</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <joint name="servo_0_joint" type="revolute"> <!-- name="cw_servo_joint" -->
        <pose relative_to="base_link">0.010312 -0.14923 0.15181 -0.018488 0 -3.14159</pose>
        <parent>base_link</parent>
        <child>servo_0</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-0.785398163</lower>
            <upper>0.785398163</upper>
          </limit>
          <dynamics>
            <damping>0.01</damping>
          </dynamics>
        </axis>
      </joint>

    <!-- right motor (cw) -->
      <link name="cw_mot_link">
        <pose relative_to="cw_mot_joint">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 9e-06 0.017847 0 0 0</pose>
          <mass>0.050</mass> <!--default :0.0136338, weight -->
          <inertia>
            <ixx>1.19292E-05</ixx>  <!-- 4.42778e-06 -->
            <ixy>0</ixy>            <!-- 6.06547e-11 -->
            <ixz>0</ixz>            <!-- 1.00593e-08 -->
            <iyy>1.19292E-05</iyy>  <!-- 4.42787e-06 -->
            <iyz>0</iyz>            <!-- 2.69765e-08 -->
            <izz>0.000018225</izz>  <!-- 8.67976e-06 -->
          </inertia>
        </inertial>
        <collision name="collision"> <!--"cw-mot_box" -->
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://bicopter/meshes/cw_mot.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://bicopter/meshes/cw_mot.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0 1 0</ambient>
            <diffuse>0 1 0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
        </link>
      <joint name="cw_mot_joint" type="revolute">
        <pose relative_to="servo_0_joint">0 0.003829 0.041455 0 0 0</pose>
        <parent>servo_0_joint</parent>
        <child>cw_mot_link</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
          <dynamics>
            <damping>0.004</damping>
          </dynamics>
        </axis>
      </joint>


<!-- plugins for actuators and tilt servo -->

    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>ccw_mot_joint</jointName>
      <linkName>ccw_mot_link</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>2e-05</motorConstant>
      <momentConstant>0.06</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0.0000806428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>servo_1_joint</joint_name>
      <sub_topic>servo_1</sub_topic>
      <p_gain>0.1</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>2</cmd_max>
      <cmd_min>-2</cmd_min>
      <err_max>0.2</err_max>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>cw_mot_joint</jointName>
      <linkName>cw_mot_link</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>2e-05</motorConstant>
      <momentConstant>0.06</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>0.0000806428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>servo_0_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
      <p_gain>0.1</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>2</cmd_max>
      <cmd_min>-2</cmd_min>
      <err_max>0.2</err_max>
    </plugin>

<!--testing props-->
    <joint name="base_to_world" type="fixed">
      <parent>world</parent>
      <child>base_link</child>
      <pose>0 0 0 0 0 0</pose >
    </joint>

<!--Plane Configuration-->

  </model>
</sdf>