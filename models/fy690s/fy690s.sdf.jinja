<?xml version="1.0" encoding="UTF-8"?> 
<sdf version='1.9'> 

  {# --- ENABLE/DISABLE ROKUBI FORCE SENSOR --- #} 
  {% set use_force_sensor = false %} 
  
  {# --- CONFIGURATION & MASS MACROS --- #} 
  {# --- NON-FRAME MASSES --- #} 
  {% set mass_nuc = 0.530 %} 
  {% set mass_sensors = 0.447 + 0.036 + 0.022 + 0.4275 %} <!-- LiDAR: 447g, PixHawk: 36g, Garmin: 22g, Miscellaneous: 427.5g -->
  {% set mass_motor = 0.097 %}  
  {% set mass_rotor = 0.0129 %} 

  {# --- FRAME MASSES --- #} 
  {% set mass_battery = 0.6114 %} 
  {% set mass_base = 0.290 %}         
  {% set mass_arm = 0.0258 %} 
  {% set mass_esc = 0.050 %} 
  {% set mass_motor_mount = 0.021 %}  
  {% set mass_leg = 0.05 %} 

  {# --- ROKUBI FORCE SENSOR MASSES --- #} 
  {% set mass_rokubi_sensor = 0.118 %} 
  {% set mass_rokubi_mount = 0.122 %} 
  {% set mass_rokubi_cabling = 0.300 %} 

  {# --- BASE DIMENSIONS --- #}   
  {% set radius = 0.345 %} 
  {% set base_h = 0.10 %} 
  {% set base_r = 0.10 %} 

  {# --- ARM DIMENSIONS --- #} 
  {% set arm_length = 0.275 %} 
  {% set arm_radius = 0.008 %} 

  {# --- MOTOR DIMENSIONS, DEFINITIONS, & CONSTANTS --- #} 
  {% set motor_radius = 0.0209 %} 
  {% set motor_height =  0.0371 %} 
  {% set motor_time_up = 0.0125 %} 
  {% set motor_time_down = 0.025 %} 
  {% set motor_max_vel = 822.05 %} 
  {% set motor_constant = 2.62e-05 %} 
  {% set moment_constant = 0.018 %} 

  {# --- ROTOR DIMENSIONS --- #} 
  {% set rotor_length = 0.3302 %}                      
  {% set rotor_width = 0.035 %} 
  {% set rotor_thickness = 0.001 %} 

  {# --- LEG DIMENSIONS --- #} 
  {% set leg_radius = 0.008 %} 
  {% set leg_length = 0.3 %} 

  {# --- CONSTANTS --- #} 
  {% set rolling_moment_coeff = 1e-06 %} 
  {% set pi = 3.14159265359 %} 
  {# Trigonometric constants for 30 +/- 60n degrees #} 
  {# Indices: 0:30, 1:90, 2:150, 3:210, 4:270, 5:330 #} 
  {% set cos_vals = [0.866025, 0.0, -0.866025, -0.866025, 0.0, 0.866025] %} 
  {% set sin_vals = [0.5, 1.0, 0.5, -0.5, -1.0, -0.5] %} 

  {# --- INERTIA EQUATION MACROS --- #} 
  {# Solid Cylinder: Ixx = Iyy = 1/12 * m * (3r^2 + h^2) | Izz = 1/2 * m * r^2 #} 
  {% macro cylinder_inertia(m, r, h) %} 
    <inertia> 
      <ixx>{{ (1/12) * m * (3 * r**2 + h**2) }}</ixx> 
      <ixy>0</ixy> 
      <ixz>0</ixz> 
      <iyy>{{ (1/12) * m * (3 * r**2 + h**2) }}</iyy> 
      <iyz>0</iyz> 
      <izz>{{ 0.5 * m * r**2 }}</izz> 
    </inertia> 
  {% endmacro %} 

  {# Rectangular Prism (Rotors): Ixx = 1/12 * m * (y^2 + z^2) | Iyy = 1/12 * m * (x^2 + z^2) | Izz = 1/12 * m * (x^2 + y^2) #} 
  {% macro box_inertia(m, x, y, z) %} 
    <inertia> 
      <ixx>{{ (1/12) * m * (y**2 + z**2) }}</ixx> 
      <ixy>0</ixy> 
      <ixz>0</ixz> 
      <iyy>{{ (1/12) * m * (x**2 + z**2) }}</iyy> 
      <iyz>0</iyz> 
      <izz>{{ (1/12) * m * (x**2 + y**2) }}</izz> 
    </inertia> 
  {% endmacro %} 

  {# --- FY690S HEXAROTOR MODEL --- #} 
  <model name='fy690s'> 
    <pose>0 0 0.4 0 0 0</pose> 
    <self_collide>false</self_collide> 
    <static>false</static> 

    {# --- ARM ENDPOINT FRAMES --- #} 
    {% for n in range(6) %} 
    {% set angle_rad = (30 + (n * 60)) * pi / 180 %} 
    <frame name="arm_{{ n }}_endpoint" attached_to="base_link"> 
        <pose>{{ radius * cos_vals[n] }} {{ radius * sin_vals[n] }} 0.014 0 0 {{ angle_rad - pi }}</pose> 
    </frame> 
    {% endfor %} 

    {# --- BASE INCLUDING NUC, PIXHAWK, BATTERY HOLDER, ETC --- #} 
    <link name="base_link"> 
      <inertial> 
        <pose>0 0 -0.02 0 0 0</pose>  
        {% set total_base_mass = mass_base + mass_battery + mass_sensors + mass_nuc + (mass_rokubi_cabling if use_force_sensor else 0.0) %} 
        <mass>{{ total_base_mass }}</mass> 
        {{ cylinder_inertia(total_base_mass, base_r, base_h) }} 
      </inertial> 
  
      <visual name="base_link_visual"> 
        <pose>0 0 0.025 0 0 {{ (pi/2) }}</pose> 
        <geometry><mesh><uri>model://fy690s/meshes/body.dae</uri></mesh></geometry> 
        <material><ambient>0.5 0.5 0.5 1.0</ambient><diffuse>0.5 0.5 0.5 1.0</diffuse></material> 
      </visual> 

      <visual name="body_top_visual"> <pose>0 0 0.025 0 0 0</pose>  
        <geometry> 
          <mesh><uri>model://fy690s/meshes/body_top.dae</uri></mesh> 
        </geometry> 
        <material><ambient>0.25 0.25 0.25 1.0</ambient><diffuse>0.25 0.25 0.25 1.0</diffuse></material> 
      </visual> 

      <collision name="base_link_collision"> 
        <pose>0 0 0.1 0 0 0</pose> 
        <geometry><cylinder><radius>{{ base_r }}</radius><length>0.2</length></cylinder></geometry> 
      </collision> 

      {# --- SENSORS FOUND WITHIN THE BASE --- #} 
      <sensor name="air_pressure_sensor" type="air_pressure"> 
        <always_on>1</always_on> 
        <update_rate>50</update_rate> 
        <air_pressure><pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure></air_pressure>
      </sensor> 

      <sensor name="magnetometer_sensor" type="magnetometer"> 
        <always_on>1</always_on> 
        <update_rate>100</update_rate> 
        <magnetometer> 
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x> 
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y> 
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z> 
        </magnetometer> 
      </sensor> 

      <sensor name="imu_sensor" type="imu"> 
        <always_on>1</always_on> 
        <update_rate>250</update_rate> 
        <imu> 
          <angular_velocity> 
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity> 
          <linear_acceleration> 
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration> 
        </imu> 
      </sensor> 

      <sensor name="navsat_sensor" type="navsat"> 
        <always_on>1</always_on> 
        <update_rate>30</update_rate> 
      </sensor> 
    </link> 

    {# --- LINKS --- #} 
    {% for n in range(6) %} 
    {% set angle_rad = (30 + (n * 60)) * pi / 180 %} 

    <link name="arm_{{ n }}_link"> 
      <pose>{{ radius * cos_vals[n] }} {{ radius * sin_vals[n] }} 0.014 {{ -(pi/2) }} 0 {{ angle_rad + (pi/2) }}</pose> 
      <inertial> 
        <pose>0 0 {{ arm_length / 2 }} 0 0 0</pose>  
        <mass>{{ mass_arm + mass_esc }}</mass>  
        {{ cylinder_inertia(mass_arm + mass_esc, arm_radius, arm_length) }} </inertial> 
      <visual name="arm_{{ n }}_visual"> 
        <pose>0 0 0 0 0 0</pose> 
        <geometry><mesh><uri>model://fy690s/meshes/arm.dae</uri></mesh></geometry> 
      </visual> 
    </link> 

    <link name="motor_{{ n }}"> 
      <pose relative_to="arm_{{ n }}_endpoint">-0.05 0 0.03 0 0 0</pose> 
      <inertial> 
        <mass>{{ mass_motor + mass_motor_mount }}</mass> 
        {{ cylinder_inertia(mass_motor + mass_motor_mount, motor_radius, motor_height) }} 
      </inertial> 
      <visual name="motor_{{ n }}_visual"> 
        <pose>0 0 0 0 0 0</pose> 
        <geometry><mesh><uri>model://fy690s/meshes/motor.dae</uri></mesh></geometry> 
      </visual> 
      <visual name="motor_mount_{{ n }}_visual"> 
        <pose relative_to="arm_{{ n }}_endpoint">0.02 0 0 0 0 0</pose> 
        <geometry><mesh><uri>model://fy690s/meshes/motor_mount_red.dae</uri></mesh></geometry>
      </visual> 
    </link> 

    <link name="rotor_{{ n }}"> 
      <pose relative_to="arm_{{ n }}_endpoint">-0.05 0 0.03 0 0 0</pose> 
      <inertial> 
        <mass>{{ mass_rotor }}</mass> 
        {{ box_inertia(mass_rotor, rotor_length, rotor_width, rotor_thickness) }} 
      </inertial> 
      <visual name="rotor_{{ n }}_visual"> 
        <geometry><mesh><uri>model://fy690s/meshes/tarot_t650_prop_low_poly.dae</uri></mesh></geometry>
        <material><ambient>0.05 0.05 0.05 1.0</ambient><diffuse>0.05 0.05 0.05 1.0</diffuse></material> 
      </visual> 
      <collision name="rotor_{{ n }}_collision"> 
        <geometry><box><size>{{ rotor_length }} {{ rotor_width }} {{ rotor_thickness }}</size></box></geometry> 
      </collision> 
    </link> 
     
    {# --- JOINTS --- #} 
    <joint name="arm_{{ n }}_joint" type="fixed"> 
      <pose>0 0 {{ arm_length }} 0 0 0</pose> 
      <parent>base_link</parent>  
      <child>arm_{{ n }}_link</child> 
    </joint> 

    <joint name="rotor_{{ n }}_joint" type="revolute"> 
      <parent>motor_{{ n }}</parent> 
      <child>rotor_{{ n }}</child> 
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit></axis>
    </joint> 

    <joint name="motor_{{ n }}_joint" type="fixed"> 
      <pose>0 0 -0.03 0 0 0</pose> 
      <parent>arm_{{ n }}_link</parent>  
      <child>motor_{{ n }}</child> 
    </joint> 
    {% endfor %} 

    {# --- LANDING GEAR VISUAL (Negligible mass to protect physics) --- #}
    <link name="landing_gear_visual_link">
      <pose>0 0 0.025 0 0 {{ (pi/2) }}</pose>
      <inertial>
        <mass>1e-5</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-5</iyy>
          <iyz>0</iyz>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <visual name="landing_gear_visual">
        <geometry>
          <mesh>
            <uri>model://fy690s/meshes/landing_gear.dae</uri>
          </mesh>
        </geometry>
        <material><ambient>0.35 0.35 0.35 1.0</ambient><diffuse>0.35 0.35 0.35 1.0</diffuse></material>
      </visual>
    </link>

    <joint name="landing_gear_visual_joint" type="fixed">
      <parent>base_link</parent>
      <child>landing_gear_visual_link</child>
    </joint>

    {# --- LANDING GEAR PHYSICS (Invisible collisions & inertia) --- #}
    {% for i in [1, 2] %}
    {% set flip = 1 if i == 1 else -1 %}
    <link name="landing_gear_{{ i }}">
      <pose>0 {{ 0.08 * flip }} 0 {{ 0.2618 * flip }} 0 0</pose>
      <inertial>
        <pose>0 0 -0.198 0 0 0</pose>
        <mass>{{ mass_leg }}</mass>
        {{ cylinder_inertia(mass_leg, leg_radius, leg_length) }} </inertial>

      <collision name="leg_{{ i }}_c">
        <pose>0 0 -0.22 0 {{ (pi/2) }} 0</pose>
        <geometry><cylinder><radius>{{ leg_radius }}</radius><length>{{ leg_length }}</length></cylinder></geometry> </collision>
    </link>

    <joint name="leg_{{ i }}_joint" type="fixed">
      <parent>base_link</parent>
      <child>landing_gear_{{ i }}</child>
    </joint>
    {% endfor %}

    {# --- ROKUBI FORCE TORQUE SENSOR --- #} 
    {% if use_force_sensor %} 
    <link name="rokubi_holder_link"> 
      <pose>0.77 0 0.0265 0 0 {{ -pi/2 }}</pose> 
      <inertial> 
        <mass>{{ mass_rokubi_mount }}</mass> 
        {{ cylinder_inertia(mass_rokubi_mount, 0.02, 0.02) }} 
      </inertial> 
      <visual name="rokubi_holder_visual"> 
        <geometry><mesh><uri>model://fy690s/meshes/rokubi_holder.dae</uri></mesh></geometry>
        <material><ambient>0.25 0.25 0.25 1.0</ambient><diffuse>0.25 0.25 0.25 1.0</diffuse></material> 
      </visual> 
      <collision name="rokubi_holder_collision"> 
        <geometry><mesh><uri>model://fy690s/meshes/rokubi_holder.dae</uri></mesh></geometry>
      </collision> 
    </link> 

    <joint name="base_to_rokubi_holder_joint" type="fixed"> 
      <parent>base_link</parent> 
      <child>rokubi_holder_link</child> 
    </joint> 
    
    <link name="rokubi_sensor_link"> 
      <pose>0.77 0 0.0265 0 0 {{ -pi/2 }}</pose> 
      <inertial> 
        <mass>{{ mass_rokubi_sensor }}</mass> 
        {{ cylinder_inertia(mass_rokubi_sensor, 0.03, 0.04) }} 
      </inertial> 
      <visual name="rokubi_visual"> 
        <geometry><mesh><uri>model://fy690s/meshes/rokubi.dae</uri></mesh></geometry> 
        <material><ambient>0.7 0.0 0.0 1.0</ambient><diffuse>0.9 0.05 0.05 1.0</diffuse><specular>0.5 0.1 0.1 1.0</specular><emissive>0.3 0.0 0.0 1.0</emissive></material> 
      </visual> 
      <collision name="rokubi_sensor_collision"> 
        <geometry><mesh><uri>model://fy690s/meshes/rokubi.dae</uri></mesh></geometry> 
      </collision> 
    </link> 

    <joint name="rokubi_joint" type="revolute"> 
      <parent>rokubi_holder_link</parent> 
      <child>rokubi_sensor_link</child> 
      <axis> 
        <xyz>0 0 1</xyz> 
        <limit> 
          <lower>0</lower> 
          <upper>0</upper> 
        </limit> 
      </axis> 
      <sensor name="rokubi_ft_sensor" type="force_torque"> 
        <always_on>true</always_on> 
        <update_rate>50</update_rate> 
        <force_torque> 
          <frame>child</frame> 
          <measure_direction>child_to_parent</measure_direction> 
        </force_torque> 
      </sensor> 
    </joint> 
    {% endif %}

    {# --- PLUGINS --- #} 
    {% if use_force_sensor %} 
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"></plugin> 
    {% endif %} 

    {% for n in range(6) %} 
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"> 
      <jointName>rotor_{{ n }}_joint</jointName> 
      <linkName>rotor_{{ n }}</linkName> 
      <turningDirection>{{ 'ccw' if n in [0, 1, 4] else 'cw' }}</turningDirection> 
      <timeConstantUp>{{ motor_time_up }}</timeConstantUp> 
      <timeConstantDown>{{ motor_time_down }}</timeConstantDown> {# --- Macros not used in the tilt model, update --- #} 
      <maxRotVelocity>{{ motor_max_vel }}</maxRotVelocity> 
      <motorConstant>{{ motor_constant }}</motorConstant> 
      <momentConstant>{{ moment_constant }}</momentConstant> 
      <commandSubTopic>command/motor_speed</commandSubTopic> 
      <motorNumber>{{ n }}</motorNumber> 
      <rollingMomentCoefficient>{{ rolling_moment_coeff }}</rollingMomentCoefficient> 
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim> 
      <motorType>velocity</motorType> 
    </plugin> 
    {% endfor %} 
  </model> 
</sdf>