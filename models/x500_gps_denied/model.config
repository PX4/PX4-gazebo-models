<?xml version="1.0"?>
<model>
  <name>x500_gps_denied</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Derek Dietz</name>
    <email>derekdietz25@gmail.com</email>
  </author>
  <description>Variant of the x500 quadrotor used to demonstrate GPS-occluded launch behavior. Adds the GpsDegradationPlugin to the navsat sensor (to model RF occlusion/multipath while the vehicle sits inside a launch tube and gradually reacquires signal after launch) and the BodyWrench plugin on base_link (to apply a one-shot launch impulse). See worlds/gps_denied_launch.sdf for the accompanying demo world.</description>
</model>
