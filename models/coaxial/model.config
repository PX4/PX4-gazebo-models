<?xml version="1.0"?>
<model>
  <name>coaxial</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Jaeyoung Lim</name>
    <email>gokoreas@gmail.com</email>
