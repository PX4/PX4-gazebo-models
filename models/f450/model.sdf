  <!-- 10mm thickness for propeller collision -->
  <model name="f450">
    <pose>0 0 0.25 0 0 0</pose>

    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>

    <link name="base_link">

      <inertial>
    <mass>2.0232</mass>
    <inertia>
      <ixx>0.020653500000000005</ixx><ixy>0</ixy><ixz>0</ixz>
      <iyy>0.020653500000000005</iyy><iyz>0</iyz><izz>0.04046400000000001</izz>
    </inertia>
  </inertial>
